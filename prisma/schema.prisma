generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  usn           String  @id
  name          String
  dob           String?
  phone         String?
  email         String?
  current_year  Int
  auth_type     String?
  encrypted_pin String?
  details       Json    // For backward compatibility / performance metrics

  @@map("students")
}
